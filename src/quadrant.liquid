<div class="layout layout--col layout--stretch-y">
  {% if services and services.size > 0 %}
    <div class="grid grid--cols-1 stretch-y gap--none" data-overflow="true" data-overflow-counter="true">
      {% for service in services %}
        {% assign row_bg = 'bg--white' %}
        {% assign row_mod = forloop.index | modulo: 2 %}
        {% if row_mod == 0 %}
          {% assign row_bg = 'bg--gray-65' %}
        {% endif %}
        {% render 'service_row', service: service, logo_size: 'w--7', row_bg: row_bg %}
      {% endfor %}
    </div>
  {% else %}
    {% render 'empty_state', status: status, language: language %}
  {% endif %}
</div>

{% render 'board_footer', disruptions: disruptions, mode: mode, language: language %}
