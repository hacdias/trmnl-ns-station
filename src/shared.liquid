{% template service_row %}
<div class="flex p--1 flex--row flex--top bg--white {{ row_bg }}">
  <div class="flex flex--col flex--end flex--right gap--none">
    <span class="title title--small">{{ service.time }}</span>
    {% if service.delay_text != "" %}
    <span class="label label--small">{{ service.delay_text }}</span>
    {% endif %}
  </div>

  <div class="stretch flex flex--col flex--left flex--start gap--none">
    <span data-clamp="1" class="w--full title title--small">{{ service.place | escape }}</span>
    {% if service.subtitle != "" %}
    <span data-clamp="1" class="w--full description text--gray">{{ service.subtitle }}</span>
    {% endif %}
  </div>

  <div class="flex flex--row flex--left w--28">
    {% if service.track != "" %}
    <svg class="w--10 h--10 p--0 flex--center flex" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 830 830">
      <rect x="14.77" y="14.5" width="800" height="800" fill="#fff" stroke="#000" stroke-width="29"/>
      <rect y=".94" width="200" height="200"/>
      <text x="415" y="475" text-anchor="middle" dominant-baseline="middle" font-family="sans-serif" font-weight="bold" font-size="400">{{ service.track }}</text>
    </svg>
    {% endif %}
    <div class="flex flex--col gap--xsmall">
      {% assign logo = "" %}
      {% case service.operator %}
      {% when "NS", "NS Int" %}{% assign logo = "data:image/png;base64," %}
      {% when "Arriva" %}{% assign logo = "data:image/png;base64," %}
      {% when "RRReis" %}{% assign logo = "data:image/png;base64," %}
      {% when "Breng" %}{% assign logo = "data:image/png;base64," %}
      {% when "Blauwnet" %}{% assign logo = "data:image/png;base64," %}
      {% when "NMBS" %}{% assign logo = "data:image/png;base64," %}
      {% when "R-net" %}{% assign logo = "data:image/png;base64," %}
      {% endcase %}
      {% if logo != "" %}
      <img src="{{ logo }}" class="{{ logo_size }} image image-dither">
      {% endif %}
      <span class="label label--small">{{ service.type }}</span>
    </div>
  </div>
</div>
{% endtemplate %}

{% template empty_state %}
<div class="flex flex--center w--full h--[60px]">
  <span class="description">{% if status and status != "" %}{{ status }}{% else %}Geen treinen beschikbaar{% endif %}</span>
</div>
{% endtemplate %}

{% template board_footer %}
<div class="title_bar">
  {% if mode == "arrivals" %}
  {% assign board_title = "NS Aankomst van de treinen" %}
  {% else %}
  {% assign board_title = "NS Vertrek van de treinen" %}
  {% endif %}
  <span class="title">{{ board_title }}</span>
  {% if disruptions and disruptions > 0 %}
  {% if disruptions == 1 %}
  {% assign verstoring = "1 verstoring" %}
  {% else %}
  {% assign verstoring = disruptions | append: " Storingen" %}
  {% endif %}
  <span class="instance">{{ verstoring }}</span>
  {% endif %}
</div>
{% endtemplate %}
